{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // GlobalExceptionHandler already logs every unhandled exception with a
      // traceId. Leaving this at the default logs each one a second time.
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",

  // Browser origins allowed to call this API. Empty in production until the
  // deployed client's origin is set here or via AllowedOrigins__0.
  "AllowedOrigins": [],

  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },

  "FeatureManagement": {
    // Pings the database every 45 minutes so an auto-paused Azure SQL serverless
    // database never idles long enough to pause and cold-start the next caller.
    //
    // Off. The service is registered either way and re-reads this on every tick,
    // so flipping it to true switches the ping on without a redeploy. Leave it
    // off anywhere the database is not the auto-pausing kind — against LocalDB
    // it is pure noise.
    "DatabaseKeepAlive": false
  },

  // ── WorkOS ───────────────────────────────────────────────────────────────
  // Blank here on purpose, and blank means the API is OPEN, not that protected
  // endpoints answer 401: with no ClientId no JWT scheme is registered, so
  // Program.cs marks every endpoint anonymous rather than 500 on a challenge it
  // cannot issue. That is what lets a fresh clone and the test suite boot.
  //
  // Production refuses to start in that state. See AddWorkOsAuthentication.
  // Set WorkOS__ClientId in the deployment, and the same id as
  // VITE_WORKOS_CLIENT_ID for the client.
  // See CLAUDE.md → "WorkOS setup" for where each value comes from.
  "WorkOS": {
    // Dashboard → Configuration → "Client ID". Looks like client_01H...
    // Not a secret; it appears in the frontend redirect URL too.
    "ClientId": "",

    // Leave blank for the classic User Management issuer
    // (https://api.workos.com/user_management/{ClientId}), which is what
    // PremPoints validates against. Set it to https://<sub>.authkit.app only if
    // you have configured an AuthKit custom domain.
    "Authority": "",

    // Leave blank unless using an AuthKit custom domain, whose tokens carry
    // `aud` = ClientId. Classic User Management tokens have no `aud`, and
    // validating it there rejects every token.
    "Audience": ""
  }
}
