<!--
  Central Package Management: every version in the solution lives here, and the
  csproj files carry bare <PackageReference Include="..." /> with no Version.

  Worth the one extra file the moment there is more than one project — the
  OpenTelemetry packages in particular must move as a set, and four csproj files
  each naming their own version is how they silently drift apart.
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="FastEndpoints" Version="8.2.0" />
    <PackageVersion Include="FastEndpoints.Swagger" Version="8.2.0" />
    <!-- The one-shot SQLite reader for tools/Clam.Migrate. Nothing else uses it,
         and it goes when the migration has been run and Express is gone. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.2" />
    <!-- Pinned past the version Microsoft.Data.Sqlite drags in: 2.1.11 carries
         GHSA-2m69-gcr7-jv3q. Transitive, so it needs naming to be raised. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- Entra ID auth for Azure SQL. Separate package on purpose: SqlClient 7.0
         removed Azure.Core/Azure.Identity from the core driver so that everyone
         connecting with Windows auth stops paying for that dependency tree.
         Nothing references it in code — it registers the auth providers, and
         `Authentication=Active Directory Default` in a connection string is what
         uses them. Which is also how its absence fails: at runtime, on connect,
         looking like a config problem rather than a missing reference. Keep the
         version in step with Microsoft.Data.SqlClient above. -->
    <PackageVersion Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.0.2" />
    <!-- Statement PDF text extraction. Apache 2.0, and the only free .NET reader
         that exposes per-word coordinates — which the Amex parser needs, because
         that table is rebuilt from x/y positions, not from reading order. -->
    <PackageVersion Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

  <ItemGroup Label="Security">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- scrypt, for Better Auth-compatible password hashing. .NET ships PBKDF2
         and nothing else; Better Auth's stored format is scrypt or nothing. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup Label="Results and health">
    <PackageVersion Include="Ardalis.Result" Version="10.1.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Aspire">
    <!-- Aspire.Hosting.AppHost is deliberately absent: the Aspire.AppHost.Sdk
         adds that reference implicitly and versions it from the SDK version in
         Clam.AppHost.csproj. Declaring a PackageVersion for it here is an
         outright error under central package management (NU1009). -->

    <!-- AddViteApp + WithBun. Must track the AppHost SDK version. -->
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.4.6" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
  </ItemGroup>

  <ItemGroup Label="OpenTelemetry — keep on one version">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <!-- Dapper runs on SqlClient, so this is what puts each query on the Aspire
         dashboard's trace timeline. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Snapshot assertions. Verify.Http knows how to render an
         HttpResponseMessage, which is what every test here asserts on. -->
    <PackageVersion Include="Verify.Http" Version="7.5.1" />
    <PackageVersion Include="Verify.XunitV3" Version="31.28.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!-- Empties the database between tests. It reads the foreign keys and works
         out the delete order itself, which is the whole point: the hand-written
         list it replaced had to be edited every time a table was added, and
         forgetting left rows leaking into the next test. -->
    <PackageVersion Include="Respawn" Version="7.0.0" />
  </ItemGroup>

</Project>
