{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "ConnectionStrings": {
    // Resolved by AddConnectionString("Clam") in AppHost.cs and injected into
    // Clam.Api as ConnectionStrings__Clam.
    //
    // Safe to commit: LocalDB is machine-local and this uses Windows integrated
    // auth, so there is no secret in it. The Azure connection string is NOT set
    // here — put that in user-secrets (`dotnet user-secrets set
    // "ConnectionStrings:Clam" "..."` from this folder) so it never reaches git.
    "Clam": "Server=(localdb)\\MSSQLLocalDB;Database=ClamFinanceTracker;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}
