<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Clam.Api.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Every test's assert line is a bare `Verify(response)`. -->
    <Using Include="VerifyXunit.Verifier" Static="True" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebApplicationFactory: the standard ASP.NET Core in-memory host. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Verify.Http" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- The harness talks to LocalDB directly to create, populate and drop its
         throwaway database. -->
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Respawn" />
  </ItemGroup>

  <ItemGroup>
    <!-- The single source of truth for the schema. The harness applies this
         exact file, so a migration that is not reflected here fails the suite
         rather than passing against a hand-maintained copy. -->
    <None Include="..\..\db\schema.sql" Link="db\schema.sql" CopyToOutputDirectory="PreserveNewest" />

    <!-- Real Amex statements, shared with the Playwright suite rather than
         copied, so there is one set of fixtures to keep current. The parser is
         a reader of other people's file format: the only test of it worth
         trusting is one that reads the actual documents. -->
    <None Include="..\..\..\e2e\resources\statements\*-amex.pdf"
          Link="Statements\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- The HSBC statements, which are both fixtures for their own parser and
         the "wrong bank" case for Amex's guard. A truncated or synthetic PDF
         cannot stand in for the latter: it fails in the extractor, which is a
         different rejection with a different status. -->
    <None Include="..\..\..\e2e\resources\statements\*-hsbc-statement.pdf"
          Link="Statements\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- The Barclaycard statements, as downloaded — the file name is Barclays'
         own, double space and all, and is left alone so the fixture is provably
         the document rather than a tidied copy of it. -->
    <None Include="..\..\..\e2e\resources\statements\Monthly BarclayCard Statement_*.pdf"
          Link="Statements\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Clam.Api\Clam.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Approved snapshots are source. The .received.* files Verify writes on a
         mismatch are not — they are the diff, and committing one would approve
         a regression by accident. -->
    <None Update="Snapshots\**\*.verified.*" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
