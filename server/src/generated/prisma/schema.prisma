generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

enum TransactionType {
  Income
  Expense
}

// 50/30/20 classification. A Bucket total is a signed net (expense +, income −);
// Savings and Ignore are excluded from savings maths in both directions.
enum Bucket {
  Needs
  Wants
  Savings
  Ignore
}

enum Owner {
  Alex
  Casey
  Joint
}

// Rules run as a two-pass pipeline over each transaction: every Category rule
// is evaluated first, then every Bucket rule — so a Bucket rule can condition
// on the Category a Category rule just assigned.
enum RuleKind {
  Category
  Bucket
}

// Joins a rule's *positive* conditions. Negated conditions are always ANDed as
// exclusions, so a rule reads "match if (any/all positives) and none of the
// negatives" — which is what a rule with exceptions actually means, and avoids
// a nesting UI.
enum RuleJoin {
  AND
  OR
}

enum RuleField {
  Description
  Category
  Type
}

enum RuleOperator {
  Contains
  StartsWith
  EndsWith
  Exact
}

enum TabDirection {
  IOwe
  TheyOwe
}

enum TabStatus {
  Open
  Settled
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  owner     Owner? // which person (Alex/Casey) this login represents
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  image     String?
  sessions  Session[]
  accounts  Account[]

  @@map("user")
}

model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  color        String
  transactions Transaction[]
  rules        Rule[]
}

// An ordered auto-assignment rule. Within a kind, `position` is the *only*
// thing that decides precedence — first match wins, no specificity heuristic.
// The user reorders the list; what you see is what runs.
//
// Deliberately has no uniqueness constraint: a constraint is a thing that stops
// you creating a rule, and duplicates are cheap to spot in the dry-run.
model Rule {
  id           String          @id @default(cuid())
  kind         RuleKind
  position     Int
  joinOperator RuleJoin        @default(AND)
  bank         String? // null = any bank
  categoryId   String? // output for kind = Category
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bucket       Bucket? // output for kind = Bucket
  conditions   RuleCondition[]
  createdAt    DateTime        @default(now())

  @@index([kind, position])
}

model RuleCondition {
  id       String       @id @default(cuid())
  ruleId   String
  rule     Rule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  field    RuleField    @default(Description)
  operator RuleOperator @default(Contains)
  value    String
  negate   Boolean      @default(false)
  position Int

  @@index([ruleId])
}

model Transaction {
  id               String          @id @default(cuid())
  description      String
  amount           Decimal
  type             TransactionType
  date             DateTime        @default(now())
  createdAt        DateTime        @default(now())
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  externalId       String?         @unique
  note             String?
  owner            Owner           @default(Joint)
  reviewed         Boolean         @default(false)
  bucket           Bucket? // 50/30/20 classification; null = uncategorised. Source of truth for savings maths
  /// Set automatically when the field is edited by hand. Rules skip pinned
  /// fields, so "Run all rules" can never stamp over a deliberate choice.
  categoryPinned   Boolean         @default(false)
  bucketPinned     Boolean         @default(false)
  originalAmount   Decimal?
  originalCurrency String?
  /// The statement PDF this transaction was derived from, where one is known.
  /// Null for banks that have no StatementFile yet, and for rows imported before
  /// statement files existed.
  statementFileId  String?
  statementFile    StatementFile?  @relation(fields: [statementFileId], references: [id], onDelete: SetNull)

  @@index([statementFileId])
}

// One staging model per bank — each preserves that bank's raw CSV schema exactly.
// The process step normalises all of them into the shared Transaction model.

// Monzo: synced directly from the Monzo Developer API, covering both the
// uk_retail (debit) and uk_monzo_flex (Flex credit card) accounts.
// Fields mirror the API response — no CSV quirks.
model MonzoApiTransaction {
  id                String    @id @default(cuid())
  monzoId           String    @unique // tx_xxx from the API
  created           DateTime
  settled           DateTime?
  amountPence       Int // pence; negative = expense
  currency          String
  localAmountPence  Int
  localCurrency     String
  description       String // Monzo raw description field
  notes             String?
  monzoCategory     String // raw slug e.g. "eating_out"
  merchantName      String?
  merchantEmoji     String?
  merchantAddress   String?
  scheme            String?
  includeInSpending Boolean
  accountId         String
  importedAt        DateTime  @default(now())
  status            String    @default("pending")

  @@map("monzo_api_transaction")
}

model PlaidItem {
  id          String   @id @default(cuid())
  userId      String   @unique
  accessToken String
  itemId      String   @unique
  cursor      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("plaid_item")
}

model PlaidTransaction {
  id            String   @id @default(cuid())
  transactionId String   @unique
  date          String
  description   String
  amount        Float
  currency      String
  merchantName  String?
  owner         String   @default("Alex")
  importedAt    DateTime @default(now())
  status        String   @default("pending")

  @@map("plaid_transaction")
}

model MonzoCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  accountId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("monzo_credential")
}

// One row per 90-day reconciliation pass (run after every Monzo sync, or manually
// from the Admin page). `results` is a JSON string: one entry per synced account
// with its API-vs-staging diff and the details of any missing transactions.
model MonzoRecRun {
  id              String   @id @default(cuid())
  ranAt           DateTime @default(now())
  window          String   @default("90d")
  trigger         String   @default("sync") // "sync" | "manual"
  totalMissing    Int      @default(0) // gaps found in staging
  totalBackfilled Int      @default(0) // of those gaps, how many we recovered
  results         String // JSON — per-account summary + recovered tx details

  @@map("monzo_rec_run")
}

/// The source PDF a batch of staged rows came from. Uploading a statement stores
/// the bytes on the volume and records this row, so a statement is a first-class
/// thing you can list, download, re-parse and delete — rather than a loose set of
/// staged rows identifiable only by a `statementDate` string.
model StatementFile {
  id            String   @id @default(cuid())
  bank          String
  owner         String
  statementDate String?
  originalName  String
  /// SHA-256 of the file bytes. Unique, so re-uploading the identical PDF is
  /// caught at the file level regardless of how row ids are derived.
  contentHash   String   @unique
  byteSize      Int
  storageKey    String
  uploadedAt    DateTime @default(now())
  rowCount      Int?
  reconciled    Boolean  @default(false)

  amexRows     AmexTransaction[]
  transactions Transaction[]

  @@index([bank, owner])
  @@map("statement_file")
}

model AmexTransaction {
  transactionId   String   @id
  transactionDate String
  processDate     String
  description     String
  amount          String
  isCredit        Boolean  @default(false)
  foreignCurrency String?
  foreignAmount   String?
  statementDate   String
  owner           String   @default("Alex")
  importedAt      DateTime @default(now())
  status          String   @default("pending")

  /// Nullable: rows staged before statement tracking existed have no source file.
  statementFileId String?
  statementFile   StatementFile? @relation(fields: [statementFileId], references: [id], onDelete: Cascade)

  @@index([statementFileId])
  @@map("amex_transaction")
}

model BarclaysTransaction {
  id            Int      @id @default(autoincrement())
  transactionId String?  @unique
  date          String
  description   String
  amount        String
  isCredit      Boolean  @default(false)
  statementDate String
  owner         String   @default("Alex")
  importedAt    DateTime @default(now())
  status        String   @default("pending")

  @@map("barclays_transaction")
}

model SantanderTransaction {
  id            Int      @id @default(autoincrement())
  transactionId String?  @unique
  date          String
  description   String
  moneyIn       String?
  moneyOut      String?
  balance       String
  statementDate String
  owner         String   @default("Alex")
  importedAt    DateTime @default(now())
  status        String   @default("pending")

  @@map("santander_transaction")
}

model HsbcTransaction {
  id            Int      @id @default(autoincrement())
  transactionId String   @unique
  date          String
  paymentType   String
  description   String
  moneyOut      String?
  moneyIn       String?
  balance       String?
  statementDate String
  owner         String   @default("Joint")
  importedAt    DateTime @default(now())
  status        String   @default("pending")

  @@map("hsbc_transaction")
}

model ChaseTransaction {
  id            Int      @id @default(autoincrement())
  transactionId String   @unique
  date          String
  description   String
  amount        String
  isCredit      Boolean  @default(false)
  statementDate String
  owner         String   @default("Casey")
  importedAt    DateTime @default(now())
  status        String   @default("pending")

  @@map("chase_transaction")
}

model SofiTransaction {
  id            Int      @id @default(autoincrement())
  transactionId String   @unique
  date          String
  type          String
  description   String
  amount        String
  isCredit      Boolean  @default(false)
  balance       String?
  accountType   String   @default("Checking")
  statementDate String
  owner         String   @default("Casey")
  importedAt    DateTime @default(now())
  status        String   @default("pending")

  @@map("sofi_transaction")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Note {
  id        String   @id @default(cuid())
  title     String
  body      String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("note")
}

model Tab {
  id          String       @id @default(cuid())
  person      String
  description String
  amount      Decimal
  direction   TabDirection
  status      TabStatus    @default(Open)
  dueDate     DateTime?
  settledAt   DateTime?
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("tab")
}

model InvestmentAccount {
  id        String   @id @default(cuid())
  name      String
  category  String // pension | crypto | equity | cash | commodity | debt
  owner     Owner    @default(Alex)
  rate      Float?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots InvestmentSnapshot[]

  @@unique([owner, name])
  @@map("investment_account")
}

model InvestmentSnapshot {
  id        String   @id @default(cuid())
  accountId String
  date      DateTime
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@map("investment_snapshot")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
