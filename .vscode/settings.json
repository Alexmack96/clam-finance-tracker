{
    // ── appsettings*.json are JSONC, not JSON ────────────────────────────────
    //
    // .NET's JsonConfigurationProvider parses them with CommentHandling.Skip and
    // AllowTrailingCommas, so `//` is legal and this codebase uses it heavily to
    // explain what each setting is for. VS Code defaults them to strict `json`
    // and reports every comment as error 521, which buries real problems under
    // a dozen fake ones.
    //
    // launchSettings.json is deliberately NOT in this list. That one really is
    // strict JSON — `dotnet run` rejects the whole profile over a comment, and
    // Aspire then falls back to a random dashboard port. Leaving VS Code to
    // complain about it there is the correct behaviour.
    "files.associations": {
        "appsettings.json": "jsonc",
        "appsettings.*.json": "jsonc"
    },

    // ── Peacock: the app's own brand violet ──────────────────────────────────
    //
    // #b58dff is `--primary: oklch(0.74 0.19 295)` from client/src/index.css,
    // the violet the dark theme is built around.
    //
    // "Exact" has a limit here: that colour's blue channel converts to 1.199,
    // outside sRGB, so it cannot be written as a hex triplet at all — this is
    // the clipped equivalent, and it reads very slightly less vivid than the app
    // does on a wide-gamut display. Peacock takes hex only, so there is no
    // version of this that is closer.
    //
    // The other two derive from it the way Peacock does: HSL lightness ±10.
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#d6c0ff",
        "activityBar.background": "#d6c0ff",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#df4e00",
        "activityBarBadge.foreground": "#e7e7e7",
        "activityBarTop.activeBackground": "#d6c0ff",
        "activityBarTop.background": "#d6c0ff",
        "activityBarTop.foreground": "#15202b",
        "activityBarTop.inactiveForeground": "#15202b99",
        "commandCenter.border": "#15202b99",
        "commandCenter.foreground": "#15202b",
        "sash.hoverBorder": "#d6c0ff",
        "statusBar.background": "#b58dff",
        "statusBar.debuggingBackground": "#b58dff",
        "statusBar.debuggingForeground": "#15202b",
        "statusBar.foreground": "#15202b",
        "statusBarItem.hoverBackground": "#945aff",
        "statusBarItem.remoteBackground": "#bf4300",
        "statusBarItem.remoteForeground": "#15202b",
        "titleBar.activeBackground": "#b58dff",
        "titleBar.activeForeground": "#15202b",
        "titleBar.inactiveBackground": "#b58dff99",
        "titleBar.inactiveForeground": "#15202b99"
    },
    "peacock.color": "#b58dff",

    // ── Classic Visual Studio 2022 (Dark) colours for C# ─────────────────────
    //
    // VS Code's Dark+ was modelled on Visual Studio but diverged. These rules put
    // the differences back. The one you notice immediately is controlKeyword:
    // VS renders if/for/return/await in purple, VS Code renders them the same
    // blue as every other keyword, which flattens control flow into the noise.
    //
    // Driven by Roslyn's semantic tokens, so they are accurate by construction —
    // a class really is coloured as a class, not as "an identifier that looks
    // like one". Requires the C# extension (installed).
    "editor.semanticHighlighting.enabled": true,
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            // Keywords
            "keyword": "#569CD6",
            "controlKeyword": "#D8A0DF",
            "preprocessorKeyword": "#9B9B9B",
            "preprocessorText": "#A4A4A4",

            // Types. VS distinguishes these; Dark+ paints most of them teal.
            "class": "#4EC9B0",
            "recordClass": "#4EC9B0",
            "delegate": "#4EC9B0",
            "struct": "#86C691",
            "recordStruct": "#86C691",
            "interface": "#B8D7A3",
            "enum": "#B8D7A3",
            "typeParameter": "#B8D7A3",
            "namespace": "#DCDCDC",

            // Members
            "method": "#DCDCAA",
            "extensionMethod": "#DCDCAA",
            "property": "#DCDCDC",
            "field": "#DCDCDC",
            "event": "#DCDCDC",
            "enumMember": "#B8D7A3",
            "constant": "#DCDCDC",

            // Locals
            "parameter": "#9CDCFE",
            "variable": "#9CDCFE",
            "label": "#C8C8C8",

            // Literals and trivia
            "string": "#D69D85",
            "stringVerbatim": "#D69D85",
            "stringEscapeCharacter": "#FFD68F",
            "number": "#B5CEA8",
            "operator": "#B4B4B4",
            "operatorOverloaded": "#B4B4B4",
            "comment": "#57A64A",

            // XML doc comments — this codebase leans on /// heavily, and Dark+
            // greys the whole block out uniformly.
            "xmlDocCommentText": "#57A64A",
            "xmlDocCommentName": "#808080",
            "xmlDocCommentDelimiter": "#808080",
            "xmlDocCommentAttributeName": "#808080",
            "xmlDocCommentAttributeValue": "#808080",
            "xmlDocCommentComment": "#57A64A",
            "xmlDocCommentCData": "#E9D585"
        }
    },
    // TextMate fallback, for the moments before Roslyn has produced semantic
    // tokens for a freshly opened file (and for .csproj / .slnx, which never get
    // them at all).
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            { "scope": ["comment.line.double-slash.cs", "comment.block.cs"], "settings": { "foreground": "#57A64A" } },
            { "scope": ["string.quoted.double.cs", "string.quoted.single.cs", "string.quoted.double.literal.cs"], "settings": { "foreground": "#D69D85" } },
            { "scope": ["constant.numeric.decimal.cs", "constant.numeric.hex.cs"], "settings": { "foreground": "#B5CEA8" } }
        ]
    }
}
