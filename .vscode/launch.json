{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 target. Provided by the Aspire VS Code extension
      // (microsoft-aspire.aspire-vscode), which drives the `aspire` CLI.
      //
      // The important difference from a hand-written coreclr launch: this debug
      // type starts the AppHost *and attaches a debugger to each resource it
      // spawns*. Breakpoints in Clam.Api bind. A plain coreclr launch of the
      // AppHost dll only debugs the AppHost process itself, and Aspire runs the
      // API as a separate child process the debugger never sees — so breakpoints
      // in endpoints silently never hit. That is why this replaced it.
      //
      // `program` is the workspace root; the AppHost is located via
      // aspire.config.json (appHost.path) at the repo root.
      "name": "Aspire: full stack (API + React + dashboard)",
      "type": "aspire",
      "request": "launch",
      "program": "${workspaceFolder}",
      "command": "run",
      // Opens the dashboard in your default browser, login token included.
      // The extension's own default for this is "none", which opens nothing.
      // Swap to "debugChrome" to also attach a JS debugger to the React client
      // and get breakpoints in .tsx; "integratedBrowser" keeps it inside VS Code.
      "dashboardBrowser": "openExternalBrowser",
      // Belt and braces on top of launchSettings.json having a single HTTP
      // profile. These pin the dashboard to HTTP no matter which profile the
      // extension decides to use — it prefers an "https" profile when one
      // exists, which is what produced ERR_HTTP2_INADEQUATE_TRANSPORT_SECURITY
      // on :17158 in Chrome.
      "env": {
        "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
        "ASPNETCORE_URLS": "http://localhost:15187",
        "DOTNET_DASHBOARD_OTLP_ENDPOINT_URL": "http://localhost:19187",
        "DOTNET_RESOURCE_SERVICE_ENDPOINT_URL": "http://localhost:20187"
      }
    },
    {
      // The React client, in a debugger-attached browser. Half of the "Aspire +
      // React client" compound below; launching it on its own expects the stack
      // to already be running.
      //
      // Attached rather than merely opened, because the cost is one line and it
      // buys breakpoints in .tsx, DOM inspection and network capture in the same
      // session as the C# breakpoints.
      //
      // The URL is hardcoded rather than derived. Aspire assigns resource ports
      // dynamically, but this one is pinned in AppHost.cs because WorkOS matches
      // redirect URIs exactly — so 5173 is already a fixed fact of this repo
      // rather than an assumption made here.
      "name": "Browser: React client (5173)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client",
      // Vite serves sources over the dev server, so the default sourcemap lookup
      // resolves /src/* against webRoot.
      "sourceMapPathOverrides": {
        "/src/*": "${workspaceFolder}/client/src/*",
        "/@fs/*": "/*"
      },
      "preLaunchTask": "wait: client on 5173"
    },
    {
      // For debugging the API in isolation. Skips Aspire entirely, so no
      // dashboard, no traces and no React client — the connection string comes
      // from appsettings.Development.json rather than being injected by the
      // AppHost. Faster loop when the orchestration is not what you are testing.
      "name": ".NET API only (no Aspire)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: api",
      "program": "${workspaceFolder}/api-dotnet/Clam.Api/bin/Debug/net10.0/Clam.Api.dll",
      "cwd": "${workspaceFolder}/api-dotnet/Clam.Api",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5299"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      // Fallback for when the Aspire extension is unavailable (a fresh clone
      // without it, or a CI-ish machine): start the stack however you like, then
      // run this and pick Clam.Api from the process list.
      "name": "Attach to clam-api (fallback)",
      "type": "coreclr",
      "request": "attach",
      "processName": "Clam.Api"
    }
  ],
  "compounds": [
    {
      // The F5 target: dashboard, API, client, all three debuggable.
      //
      // A compound rather than an option on the Aspire configuration, because
      // the Aspire debug type has no such option — `dashboardBrowser` decides
      // how the *dashboard* opens and nothing else, and `debuggers` configures
      // adapters for resources rather than opening URLs.
      //
      // Order is load-bearing. VS Code starts these in array order, so Aspire
      // goes first and the browser's preLaunchTask then polls 5173 while the
      // stack boots behind it.
      //
      // No `stopAll`. With it, closing the browser tab would tear down the whole
      // stack, which is a surprising way to lose a dashboard. The cost is that
      // the stop button only ends the session it is aimed at.
      "name": "Aspire + React client",
      "configurations": [
        "Aspire: full stack (API + React + dashboard)",
        "Browser: React client (5173)"
      ],
      "presentation": { "order": 1 }
    }
  ]
}
